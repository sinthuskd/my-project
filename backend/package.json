{
  "name": "sportsbook-backend",
  "version": "3.0.0",
  "description": "SportsBook backend: auth + SMS OTP, admin panel API (facilities, slots, prices, dashboard), courts/venues/search, bookings, wallet, match pass (NestJS + PostgreSQL)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migrate": "nest build && node dist/db/cli.js migrate",
    "seed": "nest build && node dist/db/cli.js seed",
    "db:reset": "nest build && node dist/db/cli.js reset",
    "create-admin": "nest build && node dist/db/cli.js admin",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:admin": "node scripts/admin-smoke-test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.5.4"
  }
}
