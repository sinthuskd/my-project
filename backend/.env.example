PORT=3000

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL_DAYS=7

# true  = OTP is printed in this terminal AND returned to the app (shown on the OTP screen).
# false = OTP only goes to the SMS sender (see src/sms/sms.sender.ts). Always false in production.
OTP_DEV_MODE=true

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgres://sportsbook:sportsbook@localhost:5432/sportsbook
# Set true for managed databases that require TLS (Neon, Supabase, Render, RDS ...)
PGSSL=false

# Create tables automatically when the server starts
AUTO_MIGRATE=true
# Insert the venues/courts from src/db/seed-data.ts when the venues table is empty
# (the project ships with NO dummy data, so keep false and add your real data)
AUTO_SEED=false

# Ask for an SMS code (OTP) before a WALLET payment is taken. Set false to skip the code.
PAYMENT_OTP=true

# Dev only: allow POST /wallet/topup to credit money without a payment gateway
ALLOW_DEV_TOPUP=true

# First admin (admin panel login). Created/promoted automatically when the server starts,
# or run:  npm run create-admin
ADMIN_EMAIL=admin@sportsbook.lk
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator
# Only needed if +94700000000 is already used by a customer account
ADMIN_PHONE=+94700000000
